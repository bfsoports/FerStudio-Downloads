extends RefCounted
## Estados de cocción: crudo -> cocinándose -> cocinado -> quemado, velocidad de cocción y calidad.

func run(t) -> void:
	var S := FoodItem.State
	t.eq(FoodItem.state_for(0.0, 8.0, 8.0), S.RAW, "progreso 0 = crudo")
	t.eq(FoodItem.state_for(3.0, 8.0, 8.0), S.COOKING, "cocinándose")
	t.eq(FoodItem.state_for(8.0, 8.0, 8.0), S.COOKED, "cocinado al llegar al tiempo")
	t.eq(FoodItem.state_for(15.9, 8.0, 8.0), S.COOKED, "sigue cocinado dentro de la ventana")
	t.eq(FoodItem.state_for(16.0, 8.0, 8.0), S.BURNT, "quemado al pasarse")
	var p := FoodItem.new().setup("patty")
	t.eq(p.state, S.RAW, "la carne nace cruda")
	t.ok(p.is_cookable(), "la carne es cocinable")
	t.ok(p.advance_cooking(4.0, 1.0), "cambia a cocinándose")
	t.eq(p.state, S.COOKING, "estado cocinándose")
	t.ok(p.advance_cooking(4.5, 1.0), "cambia a cocinado")
	t.eq(p.state, S.COOKED, "estado cocinado")
	t.eq(p.doneness_quality(), 1.0, "retirada en su punto = calidad 1")
	t.ok(p.advance_cooking(8.0, 1.0), "cambia a quemado")
	t.eq(p.state, S.BURNT, "estado quemado")
	t.ok(not p.advance_cooking(5.0, 1.0), "una carne quemada no cambia más")
	p.free()
	var q := FoodItem.new().setup("patty")
	q.advance_cooking(4.0, 2.0)
	t.eq(q.state, S.COOKED, "una mejora de velocidad x2 cocina el doble de rápido")
	q.free()
	var late := FoodItem.new().setup("patty")
	late.advance_cooking(14.0, 1.0)
	t.eq(late.doneness_quality(), 0.85, "pasarse un poco baja la calidad")
	late.free()
	var l := FoodItem.new().setup("lettuce")
	t.ok(not l.is_cookable(), "la lechuga no se cocina")
	t.ok(not l.advance_cooking(5.0, 1.0), "un ingrediente no cocinable no cambia de estado")
	l.free()
	var f := FoodItem.new().setup("fries")
	t.eq(str(Catalog.cook_config("fries")["station"]), "fryer", "las patatas se cocinan en la freidora")
	f.free()
