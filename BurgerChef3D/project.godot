; Archivo de configuración del motor (Godot 4.7.2).
config_version=5

[application]

config/name="Burger Chef 3D"
config/description="Simulador 3D en primera persona de una hamburguesería para Android."
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.035, 0.043, 0.075, 1)
config/icon="res://icon.png"

[autoload]

Events="*res://scripts/core/events.gd"
Loc="*res://scripts/core/loc.gd"
Catalog="*res://scripts/core/catalog.gd"
SettingsManager="*res://scripts/save/settings_manager.gd"
GameState="*res://scripts/core/game_state.gd"
SaveManager="*res://scripts/save/save_manager.gd"
EconomyManager="*res://scripts/economy/economy_manager.gd"
MissionManager="*res://scripts/missions/mission_manager.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
SceneManager="*res://scripts/core/scene_manager.gd"
Haptics="*res://scripts/core/haptics.gd"
Ads="*res://scripts/ads/ads_manager.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=576
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": true
}

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[internationalization]

locale/fallback="es"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interactable"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
