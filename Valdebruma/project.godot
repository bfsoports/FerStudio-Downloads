; Engine configuration file.
; Valdebruma — Godot Engine 4.7.2 stable.

config_version=5

[application]

config/name="Valdebruma"
config/description="Supervivencia cooperativa en primera persona en un valle abandonado."
config/version="0.1.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/icon="res://icon.png"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.047, 0.078, 0.071, 1)
boot_splash/image="res://assets/ui/emblem.png"
boot_splash/fullsize=false
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

GameData="*res://autoload/game_data.gd"
Config="*res://autoload/config.gd"
Profile="*res://autoload/profile.gd"
Net="*res://autoload/net.gd"
Session="*res://autoload/session.gd"
AudioDirector="*res://autoload/audio_director.gd"
Controls="*res://autoload/controls.gd"
Ui="*res://autoload/ui.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/default_font_multichannel_signed_distance_field=false

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.es.translation", "res://localization/strings.en.translation")
locale/fallback="es"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=0
textures/default_filters/anisotropic_filtering_level=1

[shader_globals]

vb_wind={
"type": "vec4",
"value": Vector4(0.8, 0.6, 1, 0)
}
vb_player_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
vb_wetness={
"type": "float",
"value": 0.0
}
